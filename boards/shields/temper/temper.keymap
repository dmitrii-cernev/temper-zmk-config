#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define EXTRA 1
#define SYSTEM 2
#define MOUSE 3

// Balanced rolls, without forced-tap windows that suppress intended modifiers.
&mt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    require-prior-idle-ms = <0>;
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        alt_tab: alt_tab {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RALT>, <&kp LA(TAB)>;
        };

        extra_tab: extra_tab {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo EXTRA>, <&kp LA(TAB)>;
        };

        gui_tab: gui_tab {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LG(TAB)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp Q          &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P
                &mt LCTRL A    &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &mt RCTRL SEMI
                &mt LSHFT Z    &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &mt RSHFT FSLH
                                           &kp LCTRL   &gui_tab    &kp SPACE   &kp RET     &extra_tab   &alt_tab
            >;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
                &lt MOUSE TAB  &kp N7      &kp N8      &kp N9      &kp MINUS   &kp TILDE   &kp LPAR    &kp RPAR    &none       &kp BSPC
                &kp ESC        &kp N4      &kp N5      &kp N6      &kp EQUAL   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &lt SYSTEM APOS
                &trans         &kp N1      &kp N2      &kp N3      &kp N0      &kp NUHS    &kp LBKT    &kp RBKT    &none       &trans
                                           &trans      &kp LALT    &kp LG(SPACE) &trans    &trans      &trans
            >;
        };

        system_layer {
            display-name = "System";
            // Profiles 1-5 in physical key labels use ZMK's zero-based indices 0-4.
            bindings = <
                &none          &none         &none         &none         &none        &none       &none       &none       &none       &none
                &none          &bt BT_SEL 3  &bt BT_SEL 4   &none         &none        &none       &none       &none       &none       &trans
                &none          &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_CLR   &none       &none       &none       &none       &none
                                             &trans         &none         &none        &none       &trans      &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &trans         &none       &none       &none       &none       &none          &kp C_VOL_DN  &kp C_VOL_UP  &none          &kp PSCRN
                &none          &none       &none       &none       &none       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP  &mmv MOVE_RIGHT &none
                &none          &none       &none       &none       &none       &none          &msc SCRL_DOWN &msc SCRL_UP &none          &none
                                           &trans       &none       &none       &mkp MB1       &mkp MB2       &mkp MB3
            >;
        };
    };
};
